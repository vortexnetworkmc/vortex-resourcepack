{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "vortex:crop_seed/ember_wart",
        "model": {
          "type": "minecraft:model",
          "model": "vortex:item/crop_seed/ember_wart"
        }
      },
      {
        "when": "vortex:crop/ember_wart",
        "model": {
          "type": "minecraft:model",
          "model": "vortex:item/crop/ember_wart"
        }
      },
      {
        "when": "vortex:crop_overlay/ember_wart",
        "model": {
          "type": "minecraft:model",
          "model": "vortex:block/crop_overlay/ember_wart"
        }
      }
    ],
    "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/nether_wart"
      }
  }
}
